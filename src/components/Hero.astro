---
const personalImageAlt = "David Fernandez"
import Badge from "../components/Badge.astro"
import LinkedInIcon from "../components/icons/LinkedinIcon.astro"
import MailIcon from "../components/icons/Mail.astro"
import SocialPill from "../components/SocialPill.astro"
import Github from "./icons/Github.astro"
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-12"
      src="/projects/minifoto.jpg"
      alt={personalImageAlt}
    />
    <a
      href="https://linkedin.com/in/davidfernandezn"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible para trabajar</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-3xl dark:text-white"
  >
    Hola! 👋 Soy David Fernández Nadales
  </h1>
  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-orange-200 [&>strong]:text-orange-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    <strong>Desarrollador de Software Junior.</strong> Desde Tarragona, España.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:davidfernandez1991@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/davidfernandezn">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
    <SocialPill href="https://github.com/dacoder91">
      <Github class="size-4" />
      GitHub
    </SocialPill>
  </nav>
</div>