---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
  {
    date: "2025",
    title: "Desarrollador Junior",
    company: "Rubicon Software",
    description:
      "Colaboración en el desarrollo de soluciones ERP para clientes de diversos sectores utilizando plataformas low-code. Participación activa en el desarrollo y trabajando en equipo siguiendo metodologías ágiles, contribuyendo a la mejora continua de los procesos y en nuevos ERPs personalizados.",
    link: "https://www.rubiconsulting.es",
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
