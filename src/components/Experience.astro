---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
  {
    date: "2025",
    title: "Desarrollador Junior",
    company: "Rubicon Software",
    description:
      "Colaboración en el desarrollo de soluciones ERP para clientes de diversos sectores utilizando plataformas low-code. Participación activa en el desarrollo y trabajando en equipo siguiendo metodologías ágiles, contribuyendo a la mejora continua de los procesos y en nuevos ERPs personalizados.",
    link: "https://www.rubiconsulting.es",
  },
  {
    date: "2014 - 2024",
    title: "Atención al cliente y Administración",
    company: "Hotel, camping y agencia de viajes.",
    description:
      "Trayectoria consolidada en el sector turístico ejecutando tareas administrativas y operativas como la gestión de reservas, facturación y procesos de check-in/out. Coordinación logística de servicios de transporte y atención al cliente internacional, incluyendo el uso continuado de software de gestión (PMS/ERP) para el control de ocupación y resolución de incidencias",
  },
];
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
